---
/*
 * /gmail-webhooks - the standalone answer to "how do I get a Gmail webhook?".
 *
 * Search Console shows a real cluster here ("gmail webhook", "webhooks gmail
 * integration", "connect gmail webhook", ...) landing on the documentation,
 * which is written for someone who already runs the server and so never answers
 * the question being asked. This page answers it and pitches; the doc at
 * /docs/gmail-webhooks keeps the configuration reference.
 *
 * Keep that split. Two same-origin URLs carrying the same framing would compete
 * for one query and let Google choose between them - the mistake the /connect
 * intent aliases avoid by canonicalising rather than duplicating.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, webhooks } from "../config/landing";

const origin = (Astro.site ?? new URL(site.url)).origin;

const pageTitle = "Gmail webhooks - signed HTTP callbacks on new email";
const pageDescription =
  "Gmail has no native webhooks. What Pub/Sub push actually gives you, the " +
  "five gaps you have to fill yourself, and how to get signed, retried " +
  "callbacks when new mail arrives.";

// Held in the frontmatter rather than inline in the markup: braces in a code
// sample would otherwise be parsed as Astro expressions.
const verifySample = `import hashlib, hmac, time

def verify(secret: str, body: bytes, signature: str, timestamp: str) -> bool:
    """Validate one delivery. \`body\` must be the raw request bytes."""
    if abs(time.time() - int(timestamp)) > 300:
        return False                      # reject replays
    digest = hmac.new(
        secret.encode(),
        f"{timestamp}.".encode() + body,  # timestamp, a dot, then the body
        hashlib.sha256,
    ).hexdigest()
    return hmac.compare_digest(f"sha256={digest}", signature)`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: pageTitle,
    description: pageDescription,
    url: `${origin}/gmail-webhooks/`,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
    publisher: { "@type": "Organization", name: site.name, url: site.url },
    about: [
      { "@type": "Thing", name: "Gmail webhooks" },
      { "@type": "Thing", name: "Gmail API push notifications" },
      { "@type": "Thing", name: "Google Cloud Pub/Sub" },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: webhooks.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      {
        "@type": "ListItem",
        position: 2,
        name: "Gmail webhooks",
        item: `${origin}/gmail-webhooks/`,
      },
    ],
  },
];
---

<Base title={pageTitle} description={pageDescription} markdownPath="/gmail-webhooks.md">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Nav />
  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <a
      href="/"
      class="inline-flex min-h-11 items-center text-sm opacity-70 hover:opacity-100"
      >&larr; Back to {site.name}</a
    >

    <header class="mt-6">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {webhooks.heading}
      </h1>
      <p class="mt-4 text-xl text-accent">{webhooks.subhead}</p>
      <p class="mt-4 text-lg leading-relaxed text-fg-muted">{webhooks.lede}</p>
    </header>

    <!-- The five gaps: the substance of the page, and the part no competing
         result states plainly. -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">{webhooks.gapsHeading}</h2>
      <div class="mt-6 space-y-4">
        {
          webhooks.gaps.map((gap, i) => (
            <div class="border-l-2 border-accent py-2 pl-5">
              <h3 class="flex items-center gap-3 text-lg font-semibold">
                <span class="font-mono text-sm text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {gap.title}
              </h3>
              <p class="mt-2 text-pretty leading-relaxed text-fg-muted">{gap.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Polling is a legitimate answer and the table says so; a comparison that
         only ever concludes "use us" is not one anybody trusts. -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">{webhooks.approachHeading}</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b-2 border-border text-left">
              <th class="py-3 pr-4 font-semibold">Capability</th>
              <th class="py-3 pr-4 font-semibold">Poll the API</th>
              <th class="py-3 pr-4 font-semibold">Pub/Sub push, direct</th>
              <th class="py-3 font-semibold text-accent">{site.name}</th>
            </tr>
          </thead>
          <tbody>
            {
              webhooks.approaches.map((row) => (
                <tr class="border-b border-border/60">
                  <td class="py-3 pr-4 font-medium">{row.capability}</td>
                  <td class="py-3 pr-4 text-fg-muted">{row.polling}</td>
                  <td class="py-3 pr-4 text-fg-muted">{row.pubsub}</td>
                  <td class="py-3 text-fg">{row.us}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">Verifying a delivery</h2>
      <p class="mt-4 text-pretty leading-relaxed text-fg-muted">
        Every POST carries <code class="font-mono text-sm">X-Webhook-Signature</code>
        (<code class="font-mono text-sm">sha256=&lt;hex&gt;</code>) and
        <code class="font-mono text-sm">X-Webhook-Timestamp</code>. The scheme mirrors
        Stripe's: HMAC-SHA256 over the timestamp, a literal dot, and the raw body.
        Verify against raw bytes - re-serializing the JSON changes key order and
        whitespace, and will not match.
      </p>
      <pre
        class="mt-6 overflow-x-auto border-2 border-border bg-surface-1 p-5 font-mono text-xs leading-relaxed"><code>{verifySample}</code></pre>
      <p class="mt-4 text-sm text-fg-subtle">
        Node, header reference and the full event envelope are in the
        <a href="/docs/gmail-webhooks" class="text-accent underline hover:no-underline"
          >webhook documentation</a
        >.
      </p>
    </section>

    <div class="mt-16 border-2 border-accent bg-accent/10 p-8 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Skip the pipeline</h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty leading-relaxed text-fg-muted">
        Connect Gmail once, register an HTTPS endpoint, and get signed events on new
        mail. No Pub/Sub plumbing to maintain and no watch to remember to renew.
      </p>
      <a
        href="/#connect"
        class="mt-6 inline-flex items-center gap-2 bg-accent px-5 py-2.5 font-semibold text-accent-fg transition hover:bg-accent-strong"
      >
        Add {site.name} to your client
      </a>
    </div>

    <!-- `details` rather than a JS accordion: the answers stay in the served
         HTML, which both the long-tail queries and the FAQPage JSON-LD need. -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">{webhooks.faqHeading}</h2>
      <div class="mt-6 divide-y divide-border border-2 border-border bg-surface-1">
        {
          webhooks.faq.map((item) => (
            <details class="group px-4 sm:px-6">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium">
                {item.q}
                <svg
                  class="size-5 shrink-0 text-fg-muted transition-transform group-open:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="pb-5 text-pretty leading-relaxed text-fg-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-16 border-t border-border/60 pt-10">
      <h2 class="text-sm font-semibold text-fg-muted">Keep reading</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        <li>
          <a
            href="/docs/gmail-webhooks"
            class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
            >Webhook setup reference</a
          >
        </li>
        <li>
          <a
            href="/docs"
            class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
            >Documentation</a
          >
        </li>
        <li>
          <a
            href="/compare"
            class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
            >How {site.name} compares</a
          >
        </li>
      </ul>
    </section>
  </main>
  <Footer />
</Base>
