---
/*
 * /connect-gmail-to-<client> - one standalone setup guide per chat client.
 *
 * "Connect Gmail to Claude" and "connect Gmail to ChatGPT" are the highest-intent
 * queries this product can answer. Until now they resolved to the homepage, which
 * pitches before it answers, or to /docs/mcp/setup, which assumes the reader has
 * already picked a server. This route answers the question the search asks, in
 * the first screen, one URL per client so each can carry its client's name.
 *
 * One template renders every client, the way /vs/[slug] renders every competitor:
 * the two guides can then drift in content but never in structure, JSON-LD or
 * breadcrumb shape.
 *
 * Deliberately NOT merged with /connect. That page answers "is there an account
 * to create?" for all clients at once and canonicalises a dozen aliases onto
 * itself. Giving these the same framing would put two same-origin URLs on one
 * query - see the header of config/landing/webhooks.ts.
 */
import type { GetStaticPaths } from "astro";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, clientGuides, connect } from "../config/landing";

export const getStaticPaths = (() =>
  clientGuides.map((guide) => ({
    params: { client: guide.slug },
    props: { guide },
  }))) satisfies GetStaticPaths;

const { guide } = Astro.props;
const origin = (Astro.site ?? new URL(site.url)).origin;
const canonical = `${origin}/connect-gmail-to-${guide.slug}/`;

// Other clients to cross-link at the foot, so each guide feeds the others.
const others = clientGuides.filter((g) => g.slug !== guide.slug);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: guide.heading,
    description: guide.description,
    url: canonical,
    inLanguage: "en",
    // No `totalTime` or `estimatedCost`: both would be invented. Only the steps
    // are asserted, because only the steps are known to be true.
    step: guide.steps.map((s, i) => ({
      "@type": "HowToStep",
      position: i + 1,
      name: s.title,
      text: s.body,
      url: `${canonical}#step-${i + 1}`,
    })),
    publisher: { "@type": "Organization", name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: guide.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: guide.heading, item: canonical },
    ],
  },
];
---

<Base
  title={guide.title}
  description={guide.description}
  markdownPath={`/connect-gmail-to-${guide.slug}.md`}
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Nav />
  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
    <a
      href="/"
      class="inline-flex min-h-11 items-center text-sm opacity-70 hover:opacity-100"
      >&larr; Back to {site.name}</a
    >

    <header class="mt-6">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {guide.heading}
      </h1>
      <p class="mt-4 text-xl text-accent">{guide.subhead}</p>
      <p class="mt-4 text-lg leading-relaxed text-fg-muted">{guide.lede}</p>
    </header>

    <!-- The endpoint, above the steps. Someone who already knows their client's
         settings screen needs this and nothing else on the page. -->
    <section class="mt-12 border-2 border-border bg-surface-1 p-6">
      <h2 class="text-sm font-semibold text-fg-muted">The server URL</h2>
      <p
        class="mt-3 overflow-x-auto font-mono text-sm text-accent sm:text-base"
      >
        {connect.mcpUrl}
      </p>
      <p class="mt-3 text-sm text-fg-subtle">
        Transport is streamable HTTP. Auth is OAuth in the browser - there is no key
        to paste and no account to create.
      </p>
    </section>

    {
      guide.prerequisites.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold tracking-tight">Before you start</h2>
          <ul class="mt-4 space-y-2">
            {guide.prerequisites.map((item) => (
              <li class="flex gap-3 text-pretty leading-relaxed text-fg-muted">
                <span class="text-accent" aria-hidden="true">
                  &bull;
                </span>
                {item}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">
        Add {site.name} to {guide.clientName}
      </h2>
      <ol class="mt-6 space-y-4">
        {
          guide.steps.map((step, i) => (
            <li id={`step-${i + 1}`} class="border-l-2 border-accent py-2 pl-5">
              <h3 class="flex items-center gap-3 text-lg font-semibold">
                <span class="font-mono text-sm text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {step.title}
              </h3>
              <p class="mt-2 text-pretty leading-relaxed text-fg-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">
        What {guide.clientName} can do once it is connected
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          guide.capabilities.map((cap) => (
            <div class="border-2 border-border bg-surface-1 p-5">
              <h3 class="font-semibold">{cap.title}</h3>
              <p class="mt-2 text-pretty text-sm leading-relaxed text-fg-muted">
                {cap.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <div class="mt-16 border-2 border-accent bg-accent/10 p-8 text-center">
      <h2 class="text-2xl font-bold tracking-tight">
        Add it to {guide.clientName}
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty leading-relaxed text-fg-muted">
        The install picker has the one-click link for {guide.clientName} and the
        click-path for every other MCP client.
      </p>
      <a
        href="/#connect"
        class="mt-6 inline-flex items-center gap-2 bg-accent px-5 py-2.5 font-semibold text-accent-fg transition hover:bg-accent-strong"
      >
        Open the install picker
      </a>
    </div>

    <!-- `details` rather than a JS accordion: the answers stay in the served
         HTML, which both the long-tail queries and the FAQPage JSON-LD need. -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">Questions</h2>
      <div class="mt-6 divide-y divide-border border-2 border-border bg-surface-1">
        {
          guide.faq.map((item) => (
            <details class="group px-4 sm:px-6">
              <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium">
                {item.q}
                <svg
                  class="size-5 shrink-0 text-fg-muted transition-transform group-open:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="pb-5 text-pretty leading-relaxed text-fg-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-16 border-t border-border/60 pt-10">
      <h2 class="text-sm font-semibold text-fg-muted">Keep reading</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {
          others.map((other) => (
            <li>
              <a
                href={`/connect-gmail-to-${other.slug}`}
                class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
              >
                Connect Gmail to {other.clientName}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/ai-email-triage"
            class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
            >AI email triage</a
          >
        </li>
        <li>
          <a
            href="/docs/mcp/setup"
            class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
            >Setup reference</a
          >
        </li>
        <li>
          <a
            href="/compare"
            class="inline-block border border-border px-4 py-2 text-sm text-fg-muted transition hover:border-accent hover:text-fg"
            >Gmail MCP alternatives</a
          >
        </li>
      </ul>
    </section>
  </main>
  <Footer />
</Base>
