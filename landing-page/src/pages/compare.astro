---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import PillarCards from "../components/PillarCards.astro";
import KeepReading from "../components/KeepReading.astro";
import { site, comparison, clientGuides, guidePath } from "../config/landing";

const origin = (Astro.site ?? new URL(site.url)).origin;

// Category-led, not brand-led: the query this page has to win is "gmail mcp
// alternatives", and a title starting with "Compare DaySurface" spends its most
// weighted words on a term the searcher did not type. The brand still closes the
// title so the result is attributable in the SERP.
const pageTitle = `Gmail MCP alternatives compared - ${site.name}`;
const pageDescription = comparison.pageDescription;

// schema.org: a comparison WebPage that lists the competitors we cover, plus a
// breadcrumb. Advertised via /schemamap.xml so answer engines pick it up.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: pageTitle,
    description: pageDescription,
    url: `${origin}/compare`,
    isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
    about: comparison.competitors.map((c) => ({ "@type": "Thing", name: c.name })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "DaySurface comparisons",
    itemListElement: comparison.competitors.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `DaySurface vs ${c.name}`,
      url: `${origin}/vs/${c.id}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${origin}/compare` },
    ],
  },
];
---

<Base title={pageTitle} description={pageDescription} markdownPath="/compare.md">
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Nav />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <a href="/" class="inline-flex min-h-11 items-center text-sm opacity-70 hover:opacity-100">&larr; Back to {site.name}</a>

    <header class="mt-6 max-w-3xl">
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {comparison.pageHeading}
      </h1>
      <p class="mt-4 text-lg text-fg-muted">{comparison.pageSubhead}</p>
    </header>

    <!-- The three pillars -->
    <section class="mt-14">
      <PillarCards as="h2" />
    </section>

    <!-- Full matrix -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">At a glance</h2>
      <div class="mt-6">
        <ComparisonTable competitors={comparison.competitors} />
      </div>
    </section>

    <!-- Per-competitor cards -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold tracking-tight">Head-to-head</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          comparison.competitors.map((c) => (
            <a
              href={`/vs/${c.id}`}
              class="group flex flex-col border-2 border-border bg-surface-1 p-6 transition hover:border-accent"
            >
              <span class="font-mono text-xs uppercase tracking-widest text-fg-subtle">
                {c.category}
              </span>
              <h3 class="mt-2 text-xl font-semibold">
                DaySurface vs {c.name}
              </h3>
              <p class="mt-3 grow text-pretty leading-relaxed text-fg-muted">
                {c.headline}
              </p>
              <span class="mt-4 inline-flex items-center gap-2 font-medium text-accent">
                Read the comparison
                <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="mt-16 border-t border-border/60 pt-10 text-center">
      <a
        href="/#connect"
        class="inline-flex items-center gap-2 bg-accent px-5 py-2.5 font-semibold text-accent-fg transition hover:bg-accent-strong"
      >
        Add DaySurface to your client
      </a>
    </div>

    <!-- Someone comparing servers has already decided they want one, so the
         per-client setup guides are the most useful next click from here. This
         page is also indexed, which the guides are not yet - it can pass that
         on. -->
    <KeepReading
      class="mt-16"
      heading="Set it up"
      links={[
        ...clientGuides.map((g) => ({
          label: `Connect Gmail to ${g.clientName}`,
          href: guidePath(g.slug),
        })),
        { label: "AI email triage", href: "/ai-email-triage" },
        { label: "Gmail webhooks", href: "/gmail-webhooks" },
      ]}
    />
  </main>
  <Footer />
</Base>
