---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import NumberedList from "../components/NumberedList.astro";
import ChatMock from "../components/ChatMock.astro";
import PillarCards from "../components/PillarCards.astro";
import FinalCta from "../components/FinalCta.astro";
import KeepReading from "../components/KeepReading.astro";
import { site, product } from "../config/landing";

const origin = (Astro.site ?? new URL(site.url)).origin;

// schema.org: a WebPage describing the product, plus a breadcrumb. Advertised
// via /schemamap.xml for answer engines.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: product.metaTitle,
    description: product.metaDescription,
    url: `${origin}/product`,
    isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Product", item: `${origin}/product` },
    ],
  },
];
---

<Base
  title={product.metaTitle}
  description={product.metaDescription}
  markdownPath="/product.md"
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Nav />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <a href="/" class="inline-flex min-h-11 items-center text-sm opacity-70 hover:opacity-100">&larr; Back to {site.name}</a>

    <!-- Hero: copy left, the live homepage ChatMock right (client toggle + inbox app). -->
    <header class="mt-6 grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
      <div class="min-w-0 max-w-xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{product.heading}</h1>
        <p class="mt-4 text-lg text-fg-muted">{product.subhead}</p>
      </div>
      <div class="min-w-0"><ChatMock /></div>
    </header>

    <!-- How it works: four one-line steps -->
    <section class="mt-20">
      <h2 class="text-2xl font-bold tracking-tight">{product.howHeading}</h2>
      <NumberedList class="mt-6 max-w-3xl" items={product.steps} ordered idPrefix="step" />
    </section>

    <!-- Why it's different: the three pillar diagrams (glance, not prose) -->
    <section class="mt-20">
      <h2 class="text-2xl font-bold tracking-tight">{product.whyHeading}</h2>
      <div class="mt-6">
        <PillarCards as="h3" />
      </div>
      <p class="mt-6 text-sm text-fg-muted">
        Full capability matrix vs other Gmail MCP servers on the
        <a class="font-medium text-accent underline decoration-from-font underline-offset-2" href="/compare">comparison page</a>.
      </p>
    </section>

    <!-- Same final CTA section as the homepage: connect-your-client widget +
         flagship features, driven by the shared finalCta config. -->
    <div class="mt-8">
      <FinalCta />
    </div>

    <KeepReading
      class="mt-8"
      links={[
        { label: "Why we built it", href: "/story" },
        { label: "Compare Gmail MCP servers", href: "/compare" },
        { label: "API reference", href: "/api" },
        { label: "Documentation", href: site.docsUrl },
      ]}
    />
  </main>
  <Footer />
</Base>
