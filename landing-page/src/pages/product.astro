---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import NumberedList from "../components/NumberedList.astro";
import ProductHeroVisual from "../components/ProductHeroVisual.astro";
import PageCta from "../components/PageCta.astro";
import KeepReading from "../components/KeepReading.astro";
import { site, product, comparison, features } from "../config/landing";

const origin = (Astro.site ?? new URL(site.url)).origin;

// schema.org: a WebPage describing the product, plus a breadcrumb so the page
// is attributable in the SERP. Advertised via /schemamap.xml for answer engines.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: product.metaTitle,
    description: product.metaDescription,
    url: `${origin}/product`,
    isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site.url },
      { "@type": "ListItem", position: 2, name: "Product", item: `${origin}/product` },
    ],
  },
];
---

<Base
  title={product.metaTitle}
  description={product.metaDescription}
  markdownPath="/product.md"
>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Nav />
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <a href="/" class="inline-flex min-h-11 items-center text-sm opacity-70 hover:opacity-100">&larr; Back to {site.name}</a>

    <header class="mt-6 grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
      <div class="max-w-2xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{product.heading}</h1>
        <p class="mt-4 text-lg text-fg-muted">{product.subhead}</p>
      </div>
      <ProductHeroVisual />
    </header>

    <!-- How it works: the load-bearing sequence -->
    <section class="mt-16">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight">{product.howHeading}</h2>
        <p class="mt-3 text-pretty leading-relaxed text-fg-muted">{product.howSubhead}</p>
      </div>
      <NumberedList class="mt-8 max-w-3xl" items={product.steps} ordered idPrefix="step" />
    </section>

    <!-- What you can do: the end-user outcomes (source: features) -->
    <section class="mt-20">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight">{product.capabilitiesHeading}</h2>
        <p class="mt-3 text-pretty leading-relaxed text-fg-muted">{product.capabilitiesSubhead}</p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          features.items.map((f) => (
            <div class="flex flex-col border-2 border-border bg-surface-1 p-6">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-3 grow text-pretty text-sm leading-relaxed text-fg-muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Why it's different: the three pillars, with the full prose argument
         (pillar.body) that the homepage cards deliberately omit. -->
    <section class="mt-20">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight">{product.whyHeading}</h2>
        <p class="mt-3 text-pretty leading-relaxed text-fg-muted">{product.whySubhead}</p>
      </div>
      <div class="mt-8 space-y-6">
        {
          comparison.pillars.map((p, i) => (
            <div class="border-l-2 border-accent py-2 pl-5">
              <h3 class="flex items-center gap-3 text-lg font-semibold">
                <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, "0")}</span>
                {p.title}
              </h3>
              <p class="mt-3 max-w-3xl text-pretty leading-relaxed text-fg-muted">{p.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 text-sm text-fg-muted">
        See the full capability matrix against other Gmail MCP servers on the
        <a class="font-medium text-accent underline decoration-from-font underline-offset-2" href="/compare">comparison page</a>.
      </p>
    </section>

    <PageCta
      class="mt-20"
      heading="Add DaySurface to your client"
      body="One URL, OAuth in the browser, and your agent is triaging and drafting inside the chat. No account, nothing to install."
      ctaLabel="Get started"
      href="/connect"
    />

    <KeepReading
      class="mt-16"
      links={[
        { label: "Why we built it", href: "/story" },
        { label: "Compare Gmail MCP servers", href: "/compare" },
        { label: "API reference", href: "/api" },
        { label: "Documentation", href: site.docsUrl },
      ]}
    />
  </main>
  <Footer />
</Base>
