---
import { pricing, repoName, site } from "../config/landing";
---

{
  pricing.listed && (
    <section id="pricing" class="scroll-mt-20 border-t border-border/60 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
            {pricing.heading}
          </h2>
          <p class="mt-4 text-lg text-fg-muted">{pricing.subhead}</p>
        </div>

        <p
          class="mt-8 inline-block border-2 border-accent bg-accent/10 px-5 py-3 font-mono text-sm font-semibold text-accent"
        >
          {pricing.principle}
        </p>

        <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {pricing.tiers.map((tier) => (
            <div class="flex flex-col border border-border bg-surface-1 p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h3 class="text-lg font-semibold">{tier.name}</h3>
                {tier.repoBadge && (
                  <a
                    href={site.githubUrl}
                    title={`Open source - ${repoName} on GitHub`}
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-fg-muted transition hover:text-accent"
                  >
                    {/* Masked so the mark follows the link colour on hover. */}
                    <span
                    class="size-4 shrink-0 bg-current"
                    style="-webkit-mask:url('/logos/github.svg') center/contain no-repeat;mask:url('/logos/github.svg') center/contain no-repeat;"
                    aria-hidden="true"
                    />
                    {repoName}
                  </a>
                  )}
              </div>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="text-4xl font-bold">{tier.price}</span>
                {tier.cadence && (
                  <span class="text-fg-muted">{tier.cadence}</span>
                )}
              </div>
              {tier.note && <p class="mt-2 text-xs text-fg-subtle">{tier.note}</p>}
              <p class="mt-3 text-sm text-fg-muted">{tier.description}</p>
              <ul class="mt-6 grow space-y-3 text-sm">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6L9 17l-5-5" />
                    </svg>
                    <span class="text-fg-muted">{f}</span>
                  </li>
                ))}
              </ul>
              <a
                href={tier.href}
                class="mt-8 border-2 border-border px-5 py-2.5 text-center font-semibold text-fg transition hover:border-accent hover:text-accent"
              >
                {tier.cta}
              </a>
            </div>
          ))}
        </div>

        <p class="mt-10 text-center text-sm text-fg-muted">
          Open source and MIT-licensed:
          <a href={site.githubUrl} class="text-accent underline-offset-4 hover:underline">
            self-host every feature
          </a>
          for nothing.
        </p>
        <p class="mt-2 text-center text-sm text-fg-muted">
          <a href="/pricing#compare-tiers" class="text-accent underline-offset-4 hover:underline">
            Compare every feature, and the governance add-on &rarr;
          </a>
        </p>
      </div>
    </section>
  )
}
