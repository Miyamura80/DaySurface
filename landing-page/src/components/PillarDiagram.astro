---
/*
 * The diagram for each comparison pillar, selected by `name` (the `visual` key
 * on each pillar in config/landing/comparison.ts).
 *
 * These carry the argument the pillar paragraphs used to make in prose, so the
 * cards stay a glance rather than a read. Every diagram shares one 320x150
 * viewBox and one convention: cyan is DaySurface, grey is everyone else.
 * Colours come from Tailwind utilities (fill-accent, stroke-border, ...) so a
 * token change in global.css re-skins them.
 *
 * The marks are real: the MCP logo is the path from public/logos/mcp.svg and
 * the robot is eito.me/icons/library/generic_logos/ai/robot.svg. Only generic
 * primitives (arrows, an envelope, a key, panel chrome) are drawn by hand.
 *
 * aria-hidden because the pillar title + caption next to each diagram already
 * say the same thing to a screen reader.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;

// Row pitch for the three transport lanes: centres at 34 / 75 / 116.
const LANES = [
  { y: 14, cy: 34, label: "CLI" },
  { y: 55, cy: 75, label: "MCP" },
  { y: 96, cy: 116, label: "HTTP API" },
];

// The JSON dump on the left of the "surface" diagram - ragged bars read as an
// unreadable wall without spelling one out.
const JSON_BARS = [
  { y: 38, x: 34, w: 62 },
  { y: 50, x: 34, w: 88 },
  { y: 62, x: 44, w: 70 },
  { y: 74, x: 44, w: 54 },
  { y: 86, x: 34, w: 80 },
];
---

<div class="mx-auto w-full max-w-[340px]">
  {
    /* 01 - Interactive UI, not just JSON: a wall of JSON next to a rendered app. */
    name === "surface" && (
      <svg viewBox="0 0 320 150" class="w-full" aria-hidden="true">
        {/* Them: a dashed panel of unreadable JSON. */}
        <rect
          x="8"
          y="8"
          width="140"
          height="104"
          fill="none"
          class="stroke-border"
          stroke-dasharray="4 4"
        />
        <text x="20" y="32" font-size="13" class="fill-fg-subtle font-mono">
          {"{"}
        </text>
        <text x="20" y="104" font-size="13" class="fill-fg-subtle font-mono">
          {"}"}
        </text>
        {JSON_BARS.map((b) => (
          <rect x={b.x} y={b.y} width={b.w} height="5" class="fill-fg-subtle/50" />
        ))}

        <line x1="160" y1="22" x2="160" y2="98" class="stroke-border" />

        {/* Us: the same data rendered as an app you can act in. */}
        <rect
          x="172"
          y="8"
          width="140"
          height="104"
          class="fill-accent/5 stroke-accent"
          stroke-width="1.5"
        />
        <rect x="184" y="20" width="40" height="6" class="fill-accent/70" />
        <line x1="172" y1="34" x2="312" y2="34" class="stroke-accent/30" />
        {[44, 64, 84].map((y) => (
          <>
            <rect x="184" y={y} width="6" height="6" class="fill-accent" />
            <rect x="198" y={y + 1} width="74" height="4" class="fill-fg-subtle/60" />
          </>
        ))}
        <rect x="256" y="92" width="44" height="12" class="fill-accent" />

        <text
          x="78"
          y="132"
          font-size="8"
          text-anchor="middle"
          letter-spacing="0.08em"
          class="fill-fg-subtle font-mono"
        >
          OTHER GMAIL MCPS
        </text>
        <text
          x="242"
          y="132"
          font-size="8"
          text-anchor="middle"
          letter-spacing="0.08em"
          class="fill-accent font-mono"
        >
          DAYSURFACE
        </text>
      </svg>
    )
  }

  {
    /* 02 - One codebase, three transports: one registry fanning out to three. */
    name === "transports" && (
      <svg viewBox="0 0 320 150" class="w-full" aria-hidden="true">
        <rect
          x="8"
          y="53"
          width="100"
          height="44"
          class="fill-accent/5 stroke-accent"
          stroke-width="1.5"
        />
        <text
          x="58"
          y="79"
          font-size="11"
          text-anchor="middle"
          class="fill-accent font-sans font-semibold"
        >
          DaySurface
        </text>

        {/* Orthogonal fan-out - blueprint routing, one pitch per lane. */}
        <path d="M108 75 H152 V34 H196" fill="none" class="stroke-accent/50" />
        <path d="M108 75 H196" fill="none" class="stroke-accent/50" />
        <path d="M108 75 H152 V116 H196" fill="none" class="stroke-accent/50" />

        {LANES.map((l) => (
          <>
            <rect
              x="196"
              y={l.y}
              width="116"
              height="40"
              fill="none"
              class="stroke-border"
            />
            <text
              x="238"
              y={l.cy + 4}
              font-size="11"
              class="fill-fg font-sans font-medium"
            >
              {l.label}
            </text>
          </>
        ))}

        {/* CLI - generic terminal chevron (public/logos/cli.svg). */}
        <g
          transform="translate(210 26) scale(0.667)"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-fg-muted"
        >
          <polyline points="4 17 10 11 4 5" />
          <line x1="12" y1="19" x2="20" y2="19" />
        </g>

        {/* MCP - the real ModelContextProtocol mark (public/logos/mcp.svg). */}
        <g transform="translate(210 67) scale(0.667)" class="fill-fg-muted" fill-rule="evenodd">
          <path d="M15.688 2.343a2.588 2.588 0 00-3.61 0l-9.626 9.44a.863.863 0 01-1.203 0 .823.823 0 010-1.18l9.626-9.44a4.313 4.313 0 016.016 0 4.116 4.116 0 011.204 3.54 4.3 4.3 0 013.609 1.18l.05.05a4.115 4.115 0 010 5.9l-8.706 8.537a.274.274 0 000 .393l1.788 1.754a.823.823 0 010 1.18.863.863 0 01-1.203 0l-1.788-1.753a1.92 1.92 0 010-2.754l8.706-8.538a2.47 2.47 0 000-3.54l-.05-.049a2.588 2.588 0 00-3.607-.003l-7.172 7.034-.002.002-.098.097a.863.863 0 01-1.204 0 .823.823 0 010-1.18l7.273-7.133a2.47 2.47 0 00-.003-3.537z" />
          <path d="M14.485 4.703a.823.823 0 000-1.18.863.863 0 00-1.204 0l-7.119 6.982a4.115 4.115 0 000 5.9 4.314 4.314 0 006.016 0l7.12-6.982a.823.823 0 000-1.18.863.863 0 00-1.204 0l-7.119 6.982a2.588 2.588 0 01-3.61 0 2.47 2.47 0 010-3.54l7.12-6.982z" />
        </g>

        {/* HTTP - generic globe (public/logos/api.svg). */}
        <g
          transform="translate(210 108) scale(0.667)"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-fg-muted"
        >
          <circle cx="12" cy="12" r="10" />
          <line x1="2" y1="12" x2="22" y2="12" />
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </g>
      </svg>
    )
  }

  {
    /* 03 - Open source and self-hostable: the server and the keys sit inside
       your perimeter, with nobody's gateway in the path. */
    name === "selfhost" && (
      <svg viewBox="0 0 320 150" class="w-full" aria-hidden="true">
        {/*
          The mailbox, outside. A generic envelope rather than the Gmail mark:
          the argument here is about where the server and the keys live, which
          holds for any mail provider, so the node shouldn't pin it to one.
        */}
        <rect x="4" y="47" width="74" height="56" fill="none" class="stroke-border" />
        <g
          fill="none"
          stroke-width="1.6"
          stroke-linejoin="round"
          class="stroke-fg-muted"
        >
          <rect x="27" y="64" width="28" height="20" />
          <path d="M27 64 L41 76 L55 64" />
        </g>
        <text x="41" y="97" font-size="9" text-anchor="middle" class="fill-fg-muted font-sans">
          email
        </text>

        <line x1="78" y1="75" x2="94" y2="75" class="stroke-border" />

        {/* Your perimeter. */}
        <rect
          x="94"
          y="16"
          width="132"
          height="118"
          class="fill-accent/5 stroke-accent"
          stroke-width="1.2"
          stroke-dasharray="5 4"
        />
        <text
          x="160"
          y="34"
          font-size="8"
          text-anchor="middle"
          letter-spacing="0.1em"
          class="fill-accent font-mono"
        >
          YOUR INFRASTRUCTURE
        </text>
        <rect
          x="104"
          y="46"
          width="112"
          height="34"
          class="fill-bg stroke-accent"
          stroke-width="1.5"
        />
        <text
          x="160"
          y="67"
          font-size="11"
          text-anchor="middle"
          class="fill-accent font-sans font-semibold"
        >
          DaySurface
        </text>

        {/* Your credentials, never handed to a gateway. */}
        <g fill="none" stroke-width="1.4" stroke-linecap="round" class="stroke-fg-muted">
          <circle cx="118" cy="104" r="4" />
          <line x1="122" y1="104" x2="131" y2="104" />
          <line x1="127" y1="104" x2="127" y2="108" />
          <line x1="130.5" y1="104" x2="130.5" y2="107" />
        </g>
        <text x="137" y="107" font-size="9" class="fill-fg-muted font-sans">
          your OAuth keys
        </text>

        <line x1="226" y1="75" x2="242" y2="75" class="stroke-border" />

        {/*
          The agent, outside. Real mark from eito.me/icons - it ships as a
          currentColor icon, so `text-fg-muted` (not fill-*) is what colours it:
          the eye rects carry their own fill="currentColor" and would otherwise
          ignore a fill set on this group.
        */}
        <rect x="242" y="47" width="74" height="56" fill="none" class="stroke-border" />
        <g
          transform="translate(261.6 52.5) scale(0.1357)"
          fill="currentColor"
          class="text-fg-muted"
        >
          <circle
            cx="128"
            cy="24"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="6"
          />
          <rect x="125" y="34" width="6" height="20" />
          <path
            fill-rule="evenodd"
            d="M40,144a88,88,0,0,1,176,0v44a44,44,0,0,1-44,44H84a44,44,0,0,1-44-44Z M92,116 h72 a28,28 0 0 1 28,28 v24 a28,28 0 0 1 -28,28 h-72 a28,28 0 0 1 -28,-28 v-24 a28,28 0 0 1 28,-28 z"
          />
          <rect x="88" y="138" width="24" height="36" rx="12" fill="currentColor" />
          <rect x="144" y="138" width="24" height="36" rx="12" fill="currentColor" />
        </g>
        <text x="279" y="97" font-size="9" text-anchor="middle" class="fill-fg-muted font-sans">
          agent
        </text>
      </svg>
    )
  }
</div>
