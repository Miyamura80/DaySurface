---
// Shared GitHub glyph. The /logos/github.svg mask URL lives here only, so the
// header's labelled + icon-only variants and the mobile-sheet entry can't drift
// on the asset path. Pass sizing and colour (bg-*) via `class`.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={["shrink-0", className]}
  style="-webkit-mask:url('/logos/github.svg') center/contain no-repeat;mask:url('/logos/github.svg') center/contain no-repeat;"
  aria-hidden="true"
></span>
