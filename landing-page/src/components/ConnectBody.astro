---
/*
 * The connect content, shared by `/connect` and every intent alias
 * (`/signup`, `/login`, ...) so the two can never drift. The <Base> wrapper
 * lives in the pages, because the aliases need a different canonical + noindex.
 *
 * Kept deliberately small: this page exists to stay legible after a fetcher has
 * truncated it, so it carries no chat mockups, no comparison SVGs and no
 * client-side dropdown - every client's link is in the markup, always visible.
 */
import { site, connectPage } from "../config/landing";
import { effortMeta, groupedInstallMatrix } from "../lib/install";

const groups = groupedInstallMatrix();
---

<main class="mx-auto max-w-3xl px-4 py-12 leading-relaxed sm:px-6 sm:py-16">
    <a href="/" class="inline-flex min-h-11 items-center text-sm opacity-70 hover:opacity-100"
      >&larr; Back to {site.name}</a
    >
    <h1 class="mt-6 text-4xl font-bold">{connectPage.title}</h1>

    <p class="mt-6 text-lg">{connectPage.noAccount}</p>

    <dl class="mt-8 border border-border bg-surface-1 p-4 font-mono text-sm sm:p-6">
      {
        connectPage.facts.map((f) => (
          <div class="flex flex-col gap-1 py-1.5 sm:flex-row sm:gap-4">
            <dt class="shrink-0 uppercase tracking-widest text-fg-subtle sm:w-28">
              {f.label}
            </dt>
            <dd class="min-w-0 break-all text-accent">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-6 opacity-80">{connectPage.agentShortcut}</p>

    {
      groups.map((g) => (
        <section class="mt-10">
          <h2 class="text-2xl font-semibold">{g.heading}</h2>
          {/* Printed once per group rather than per client: four prompt targets
              share one ~450-char prompt, and repeating it added ~1.5KB to a page
              whose whole job is surviving a fetcher's truncation. */}
          {g.sharedPrompt && (
            <>
              <p class="mt-3 text-sm opacity-70">Paste this into any of the clients below:</p>
              <pre class="mt-2 overflow-x-auto border border-border bg-bg p-3 font-mono text-xs"><code>{g.sharedPrompt}</code></pre>
            </>
          )}
          <ul class="mt-4 space-y-6">
            {g.clients.map((c) => (
              <li>
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <span class="text-lg font-semibold">{c.name}</span>
                  {c.install_url && (
                    <a
                      class="inline-flex min-h-11 items-center border border-accent px-3 text-sm text-accent hover:bg-accent hover:text-bg"
                      href={c.install_url}
                    >
                      {c.effort === "dialog-only" ? "Open the dialog" : `Add to ${c.name}`}
                    </a>
                  )}
                </div>
                {c.setup_kind === "command" && c.setup_prompt && (
                  <pre class="mt-2 overflow-x-auto border border-border bg-bg p-3 font-mono text-xs"><code>{c.setup_prompt}</code></pre>
                )}
                {c.note && <p class="mt-2 text-sm opacity-70">{c.note}</p>}
                {c.setup_prompt && c.setup_kind !== "command" && c.setup_prompt !== g.sharedPrompt && (
                  <pre class="mt-2 overflow-x-auto border border-border bg-bg p-3 font-mono text-xs"><code>{c.setup_prompt}</code></pre>
                )}
                {c.steps && c.steps.length > 0 && (
                  <details class="mt-2">
                    <summary class="min-h-11 cursor-pointer py-2 text-sm opacity-70">
                      {effortMeta[c.effort].stepsLabel}
                    </summary>
                    <ol class="mt-2 list-decimal space-y-1 pl-6 text-sm opacity-80">
                      {c.steps.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ol>
                  </details>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section class="mt-12 border-t border-border pt-8">
      <h2 class="text-2xl font-semibold">After connecting</h2>
      <p class="mt-3">
        Your client completes Google sign-in in the browser and the tools appear
        automatically. Nothing is installed locally and there is no dashboard to
        visit.
      </p>
      <p class="mt-4 text-sm opacity-70">
        Reading this as an agent? The same page is available as markdown at
        <a class="text-accent underline" href="/connect.md">/connect.md</a> and as JSON at
        <a class="text-accent underline" href="/.well-known/mcp/install.json"
          >/.well-known/mcp/install.json</a
        >.
      </p>
    </section>
  </main>
