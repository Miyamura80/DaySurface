---
/**
 * The three headline differentiator cards, shared by the homepage comparison
 * section (Comparison.astro) and the /compare hub so the card markup lives in
 * one place. `as` sets the heading level for correct document outline: h3 under
 * the landing section's h2, h2 directly under the /compare page h1.
 *
 * Each card is a diagram plus one line. The full prose argument still exists -
 * it's `pillar.body`, rendered on the /vs pages and emitted into llms-full.txt
 * for answer engines, which have no diagram to read.
 */
import { comparison } from "../config/landing";
import PillarDiagram from "./PillarDiagram.astro";

interface Props {
  as?: "h2" | "h3";
}

const { as: Heading = "h3" } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-3">
  {
    comparison.pillars.map((p) => (
      <div class="flex flex-col border-2 border-border bg-surface-1 p-6">
        <PillarDiagram name={p.visual} />
        <Heading class="mt-6 text-lg font-semibold">{p.title}</Heading>
        <p class="mt-2 text-pretty text-sm leading-relaxed text-fg-muted">
          {p.caption}
        </p>
      </div>
    ))
  }
</div>
