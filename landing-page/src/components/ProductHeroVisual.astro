---
/*
 * The /product hero diagram: the thesis of the page in one glance - a real
 * product (a ranked inbox + a composer you send from) rendered *inside* a chat
 * window, rather than JSON handed back to the agent.
 *
 * Shares the site diagram convention (see PillarDiagram.astro): a single
 * viewBox, cyan = DaySurface's rendered surface, grey = chat chrome and the
 * user's own message. Colours are Tailwind utilities bound to the tokens in
 * global.css, so a token change re-skins it. aria-hidden: the hero heading and
 * subhead next to it already say this to a screen reader.
 *
 * The ranked-inbox rows: the top row is the important one (solid accent dot +
 * an "act" chip); the rest fade down the priority order.
 */

// Three ranked inbox rows. `dot`/`bar` widths and the presence of a chip encode
// priority - top row is hottest - so reordering needs no other edit.
const ROWS = [
  { y: 104, bar: 118, chip: true },
  { y: 126, bar: 96, chip: false },
  { y: 148, bar: 132, chip: false },
];
---

<div class="mx-auto w-full max-w-[420px]">
  <svg viewBox="0 0 400 340" class="w-full" aria-hidden="true">
    <!-- The chat window: the product lives in here, not in a separate app. -->
    <rect x="6" y="6" width="388" height="328" class="fill-surface-1 stroke-border" stroke-width="1.5" />

    <!-- Client chrome: an assistant avatar + label, then a hairline. -->
    <circle cx="26" cy="27" r="7" class="fill-accent" />
    <rect x="40" y="24" width="66" height="6" class="fill-fg-muted/70" />
    <text x="376" y="31" text-anchor="end" font-size="9" letter-spacing="0.1em" class="fill-fg-subtle font-mono">MCP CLIENT</text>
    <line x1="6" y1="46" x2="394" y2="46" class="stroke-border" />

    <!-- The user's own message, right-aligned: "what needs me?" -->
    <rect x="214" y="58" width="174" height="26" rx="2" class="fill-surface-2" />
    <rect x="228" y="68" width="120" height="6" class="fill-fg-muted/70" />
    <rect x="356" y="68" width="18" height="6" class="fill-fg-subtle/60" />

    <!-- The agent's reply: a rendered, cyan inbox card - the product surface. -->
    <rect x="12" y="94" width="300" height="88" class="fill-accent/5 stroke-accent" stroke-width="1.5" />
    <!-- Card header -->
    <rect x="24" y="80" width="92" height="16" class="fill-bg stroke-accent" stroke-width="1" />
    <text x="34" y="91" font-size="8" letter-spacing="0.08em" class="fill-accent font-mono">RANKED INBOX</text>

    {
      ROWS.map((r) => (
        <>
          {/* priority dot: solid accent on the hot row, hollow below */}
          <circle cx="30" cy={r.y} r="3.5" class={r.chip ? "fill-accent" : "fill-none stroke-fg-subtle"} stroke-width="1.5" />
          <rect x="42" y={r.y - 3} width={r.bar} height="6" class={r.chip ? "fill-fg/80" : "fill-fg-muted/50"} />
          {r.chip && (
            <>
              <rect x="250" y={r.y - 6} width="50" height="13" class="fill-accent" />
              <text x="275" y={r.y + 3} text-anchor="middle" font-size="7" letter-spacing="0.06em" class="fill-accent-fg font-mono">NEEDS YOU</text>
            </>
          )}
        </>
      ))
    }

    <!-- The composer: reply drafted, cyan outline, a solid Send button you press. -->
    <rect x="46" y="196" width="342" height="122" class="fill-accent/5 stroke-accent" stroke-width="1.5" />
    <rect x="58" y="182" width="78" height="16" class="fill-bg stroke-accent" stroke-width="1" />
    <text x="68" y="193" font-size="8" letter-spacing="0.08em" class="fill-accent font-mono">DRAFT REPLY</text>

    <!-- To / Subject header lines -->
    <rect x="60" y="212" width="40" height="5" class="fill-fg-subtle/70" />
    <rect x="110" y="212" width="150" height="5" class="fill-fg-muted/60" />
    <line x1="60" y1="226" x2="374" y2="226" class="stroke-accent/25" />

    <!-- Body lines -->
    {[238, 252, 266].map((y) => (
      <rect x="60" y={y} width={y === 266 ? 150 : 300} height="5" class="fill-fg-muted/45" />
    ))}

    <!-- Send button: black text on accent - the one thing only you do. -->
    <rect x="300" y="288" width="74" height="20" class="fill-accent" />
    <text x="337" y="301" text-anchor="middle" font-size="9" letter-spacing="0.04em" class="fill-accent-fg font-mono font-bold">SEND</text>
    <circle cx="70" cy="298" r="4" class="fill-none stroke-fg-subtle" stroke-width="1.5" />
    <rect x="82" y="295" width="80" height="5" class="fill-fg-subtle/60" />
  </svg>
</div>
