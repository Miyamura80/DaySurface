---
/*
 * Hero chat mock. A toggle swaps between four client shells (Claude / ChatGPT /
 * Goose / VS Code), each a stylized-but-recognizable reproduction of that client's
 * real chat UI (theme, chrome, bubbles, avatars sourced from per-client research).
 * Every shell embeds the SAME <InboxApp /> MCP-app card - a sandboxed MCP App
 * renders its own UI regardless of host, so the card stays brand-cyan everywhere.
 *
 * The toggle itself stays in the site's Hackbox style (it's our control, not a
 * client's). Each shell is full, separate markup.
 *
 * The toggle does not own the selection - it writes the page-level client state
 * (src/lib/client-state.ts), which the features frames and the connect widget
 * read too. Which shell is visible is decided in CSS off <html data-client>, so
 * a stored choice is already correct at first paint; the script below only
 * keeps the ARIA state in step and handles input.
 */
import { heroChat } from "../config/landing";
import ClaudeShell from "./chat/ClaudeShell.astro";
import ChatGptShell from "./chat/ChatGptShell.astro";
import GooseShell from "./chat/GooseShell.astro";
import VsCodeShell from "./chat/VsCodeShell.astro";

const { clients, defaultId } = heroChat;

const maskStyle = (logo: string) =>
  `-webkit-mask:url('${logo}') center/contain no-repeat;mask:url('${logo}') center/contain no-repeat;`;
---

<div class="mx-auto w-full min-w-0 max-w-md" data-chatmock>
  <!-- Client toggle (Hackbox style) -->
  <div
    class="mb-3 grid grid-cols-4 border-2 border-border bg-surface-1"
    role="tablist"
    aria-label="Preview client"
  >
    {
      clients.map((c) => (
        <button
          type="button"
          role="tab"
          id={`tab-${c.id}`}
          aria-controls={`panel-${c.id}`}
          aria-selected={c.id === defaultId ? "true" : "false"}
          tabindex={c.id === defaultId ? 0 : -1}
          data-client-tab={c.id}
          class="client-tab flex min-h-11 items-center justify-center gap-1.5 border-r-2 border-border px-2 text-xs font-medium text-fg-muted transition last:border-r-0 hover:text-fg aria-selected:bg-accent aria-selected:text-accent-fg"
        >
          <span class="size-4 shrink-0 bg-current" style={maskStyle(c.logo)} aria-hidden="true" />
          <span class="hidden sm:inline">{c.name}</span>
        </button>
      ))
    }
  </div>

  <!-- Shells; only the active one is shown, decided in CSS off the page-level
       data-client (see the style block) rather than a `hidden` attribute set by
       JS - otherwise a stored non-default choice would flash the default first.
       Each is the tabpanel for its toggle tab (role/aria-labelledby). -->
  <div>
    <div role="tabpanel" id="panel-claude" aria-labelledby="tab-claude" tabindex="0" data-shell="claude"><ClaudeShell /></div>
    <div role="tabpanel" id="panel-chatgpt" aria-labelledby="tab-chatgpt" tabindex="0" data-shell="chatgpt"><ChatGptShell /></div>
    <div role="tabpanel" id="panel-goose" aria-labelledby="tab-goose" tabindex="0" data-shell="goose"><GooseShell /></div>
    <div role="tabpanel" id="panel-vscode" aria-labelledby="tab-vscode" tabindex="0" data-shell="vscode"><VsCodeShell /></div>
  </div>
</div>

<style>
  /* display:none also takes the inactive panels out of the a11y tree, which is
     what the tabs pattern wants for an unselected tabpanel. */
  [data-shell] { display: none; }
  :root[data-client="claude"] [data-shell="claude"],
  :root[data-client="chatgpt"] [data-shell="chatgpt"],
  :root[data-client="goose"] [data-shell="goose"],
  :root[data-client="vscode"] [data-shell="vscode"] { display: block; }

  /* The selected tab's styling has to come from the same source, or a stored
     choice would paint the wrong tab highlighted until the script runs. */
  :root[data-client="claude"] .client-tab[data-client-tab="claude"],
  :root[data-client="chatgpt"] .client-tab[data-client-tab="chatgpt"],
  :root[data-client="goose"] .client-tab[data-client-tab="goose"],
  :root[data-client="vscode"] .client-tab[data-client-tab="vscode"] {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
</style>

<script>
  import { onClient, setClient } from "../lib/client-state";

  function initChatMock() {
    document.querySelectorAll<HTMLElement>("[data-chatmock]").forEach((root) => {
      // Idempotent: skip roots already wired (e.g. a repeat astro:page-load).
      if (root.dataset.chatmockReady === "true") return;
      root.dataset.chatmockReady = "true";

      const tabs = Array.from(
        root.querySelectorAll<HTMLButtonElement>(".client-tab"),
      );

      // Visibility is CSS's job now; this only mirrors the state into ARIA -
      // roving tabindex (only the selected tab is in the tab order) plus
      // aria-selected. It runs for the current client and on every change, so
      // a selection made in the connect widget lands here too.
      onClient((id) => {
        tabs.forEach((t) => {
          const on = t.dataset.clientTab === id;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
        });
      });

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => setClient(tab.dataset.clientTab!));
        // WAI-ARIA tabs keyboard pattern: Left/Right move (and activate) the
        // adjacent tab; Home/End jump to the first/last.
        tab.addEventListener("keydown", (e) => {
          let next = -1;
          if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
          else if (e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
          else if (e.key === "Home") next = 0;
          else if (e.key === "End") next = tabs.length - 1;
          else return;
          e.preventDefault();
          setClient(tabs[next].dataset.clientTab!);
          tabs[next].focus();
        });
      });
    });
  }

  initChatMock();
  document.addEventListener("astro:page-load", initChatMock);
</script>
