---
/**
 * Reusable comparison matrix. Renders the DaySurface column (always highlighted)
 * next to one or more competitor columns. Pass the subset of competitors to
 * show as columns - the /compare hub passes all of them, each /vs page passes
 * just one.
 */
import { readFileSync } from "node:fs";
import type { Competitor, MatrixRow, MatrixCell } from "../config/landing";
import { comparison } from "../config/landing";

interface Props {
  competitors: Competitor[];
  matrix?: MatrixRow[];
}

const { competitors, matrix = comparison.matrix } = Astro.props;

// Visual treatment per state. "yes" is the brand cyan win; "partial" is a
// muted tilde; "no" is a subdued dash so the table reads at a glance.
const MARK: Record<MatrixCell["state"], { glyph: string; cls: string; label: string }> = {
  yes: { glyph: "✓", cls: "text-accent", label: "Yes" },
  partial: { glyph: "~", cls: "text-fg-muted", label: "Partial" },
  no: { glyph: "–", cls: "text-fg-subtle", label: "No" },
};

/*
 * A masked span has no intrinsic size, so the aspect ratio has to come from the
 * file or a wordmark gets squeezed into a square (Zapier's is ~3:1). Read it at
 * build time rather than duplicating it in config, where it would silently rot
 * the next time a mark is replaced. PNG keeps width/height as big-endian uint32
 * at bytes 16 and 20; the .svg marks here are square.
 */
const aspect = (file: string): number => {
  if (!file.endsWith(".png")) return 1;
  const buf = readFileSync(new URL(`../../public/logos/${file}`, import.meta.url));
  return buf.readUInt32BE(16) / buf.readUInt32BE(20);
};

const maskStyle = (file: string) =>
  `aspect-ratio:${aspect(file).toFixed(3)};` +
  `-webkit-mask:url('/logos/${file}') center/contain no-repeat;` +
  `mask:url('/logos/${file}') center/contain no-repeat;`;
---

<div class="-mx-4 overflow-x-auto overscroll-x-contain px-4 sm:mx-0 sm:px-0" tabindex="0" role="region" aria-label="Capability comparison, scrollable">
  <table class="w-full min-w-[640px] border-collapse text-left">
    <thead>
      <tr class="border-b-2 border-border">
        <th scope="col" class="py-4 pr-4 align-bottom text-sm font-medium text-fg-muted">
          Capability
        </th>
        <th
          scope="col"
          class="border-x-2 border-accent bg-accent/10 px-4 py-4 align-bottom text-sm font-bold text-fg"
        >
          DaySurface
        </th>
        {
          /*
           * The mark sits above the name rather than inline: these columns are
           * narrow enough that most names already wrap to two lines, and an
           * inline icon would tighten the wrap further. `align-bottom` on the
           * th keeps every name on a common baseline whether or not its column
           * has a mark. Masked (not <img>) so the silhouette takes the link's
           * colour and lifts to white on hover with the text.
           */
          competitors.map((c) => (
            <th scope="col" class="px-4 py-4 align-bottom text-sm font-semibold text-fg-muted">
              <a href={`/vs/${c.id}`} class="block transition hover:text-fg">
                {c.logos && c.logos.length > 0 && (
                  <span class="mb-2 flex items-center gap-2.5">
                    {c.logos.map((file) => (
                      <span
                        class="block h-5 bg-current"
                        style={maskStyle(file)}
                        aria-hidden="true"
                      />
                    ))}
                  </span>
                )}
                {c.name}
              </a>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        matrix.map((row) => (
          <tr class="border-b border-border/60 align-top">
            <th scope="row" class="py-4 pr-4 text-left font-normal">
              <div class="font-medium text-fg">{row.capability}</div>
              {row.detail && (
                <div class="mt-1 text-sm text-fg-muted">{row.detail}</div>
              )}
            </th>
            <td class="border-x-2 border-accent bg-accent/10 px-4 py-4">
              <span class={`text-lg font-bold ${MARK[row.us.state].cls}`} aria-label={MARK[row.us.state].label}>
                {MARK[row.us.state].glyph}
              </span>
              {row.us.note && (
                <span class="ml-2 text-sm text-fg-muted">{row.us.note}</span>
              )}
            </td>
            {competitors.map((c) => {
              const cell = row.cells[c.id] ?? { state: "no" as const };
              return (
                <td class="px-4 py-4">
                  <span class={`text-lg font-bold ${MARK[cell.state].cls}`} aria-label={MARK[cell.state].label}>
                    {MARK[cell.state].glyph}
                  </span>
                  {cell.note && (
                    <span class="ml-2 text-sm text-fg-subtle">{cell.note}</span>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="mt-3 text-xs text-fg-subtle sm:hidden" aria-hidden="true">Scroll the table sideways to see every column.</p>
<p class="mt-4 text-xs text-fg-subtle">{comparison.disclaimer}</p>
