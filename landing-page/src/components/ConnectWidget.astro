---
/*
 * Interactive client picker for the "Add it to your client" step.
 * A dropdown selects the target app; the panel below shows either a one-click
 * install deep link (Cursor / VS Code / Goose) or the copy-the-URL + paste
 * steps (Claude / ChatGPT). Deep links are built here at build time so no
 * client JS has to know the encoding rules.
 */
import { connect } from "../config/landing";
import { effortMeta, installClientsForUi } from "../lib/install";

const { mcpUrl, defaultId } = connect;

// The shared matrix IS the list this renders - not a lookup table joined back
// onto connect.targets. Every label that varies by install effort ("1-click" vs
// "shortcut", which steps-summary to show) comes from `effortMeta`, so this
// widget cannot disagree with /connect, connect.md or install.json about
// whether a given client is one click.
const enriched = installClientsForUi;
const selected = enriched.find((t) => t.id === defaultId) ?? enriched[0];
---

<div
  class="w-full min-w-0 border-2 border-accent bg-surface-1 p-3 text-left shadow-2xl shadow-black/40 sm:p-4"
  data-connect
>
  <!-- Shared: the MCP server URL, copyable -->
  <label class="font-mono text-[11px] uppercase tracking-widest text-fg-subtle">
    MCP server URL
  </label>
  <div class="mt-1.5 flex items-stretch border border-border bg-bg">
    <code class="min-w-0 flex-1 truncate px-3 py-2.5 font-mono text-xs text-accent sm:text-sm" title={mcpUrl}>
      {mcpUrl}
    </code>
    <button
      type="button"
      class="copy-btn grid min-h-11 w-11 shrink-0 place-items-center border-l border-border text-fg-muted transition hover:bg-surface-2 hover:text-accent"
      data-code={mcpUrl}
      aria-label="Copy"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
    </button>
  </div>

  <!-- App picker (custom dropdown so we can show logos) -->
  <div class="relative mt-4" data-dropdown>
    <button
      type="button"
      class="flex min-h-11 w-full items-center gap-2.5 border border-border bg-bg px-3 text-left transition hover:border-accent/60"
      aria-haspopup="listbox"
      aria-expanded="false"
      data-dropdown-toggle
    >
      <span
        class="size-5 shrink-0 bg-fg"
        style={`-webkit-mask:url('${selected.logo}') center/contain no-repeat;mask:url('${selected.logo}') center/contain no-repeat;`}
        data-selected-logo
        aria-hidden="true"></span>
      <span class="min-w-0 flex-1 truncate text-sm font-medium text-fg" data-selected-name>{selected.name}</span>
      <svg class="size-4 text-fg-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <ul
      class="absolute z-20 mt-1 hidden max-h-72 w-full overflow-y-auto border border-accent/50 bg-surface-2 shadow-2xl shadow-black/60"
      role="listbox"
      data-dropdown-menu
    >
      {
        enriched.map((t) => (
          <li role="option" aria-selected={t.id === selected.id ? "true" : "false"}>
            <button
              type="button"
              class="flex min-h-11 w-full items-center gap-2.5 px-3 text-left text-sm text-fg-muted transition hover:bg-bg hover:text-fg"
              data-option={t.id}
              data-logo={t.logo}
              data-name={t.name}
            >
              <span
                class="size-5 shrink-0 bg-current"
                style={`-webkit-mask:url('${t.logo}') center/contain no-repeat;mask:url('${t.logo}') center/contain no-repeat;`}
                aria-hidden="true"></span>
              <span class="flex-1">{t.name}</span>
              <span
                class:list={[
                  "font-mono text-[10px] uppercase tracking-wider",
                  t.install_url ? "text-accent" : "text-fg-subtle",
                ]}
              >
                {effortMeta[t.effort].badge}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- One panel per target; only the selected one is shown -->
  <div class="mt-4">
    {
      enriched.map((t) => (
        <div data-panel={t.id} hidden={t.id !== selected.id}>
          {t.install_url ? (
            <>
              {/* A link that prefills nothing drops the visitor into an empty
                  dialog, so data-copy-on-open puts the URL on their clipboard
                  on the way out - the paste is the only step left. Astro omits
                  the attribute entirely when the value is undefined. */}
              <a
                href={t.install_url}
                data-copy-on-open={t.effort === "dialog-only" ? mcpUrl : undefined}
                class="flex min-h-12 w-full items-center justify-center gap-2.5 bg-accent px-4 text-center font-semibold text-accent-fg transition hover:bg-accent-strong"
              >
                <span
                  class="size-5 shrink-0 bg-accent-fg"
                  style={`-webkit-mask:url('${t.logo}') center/contain no-repeat;mask:url('${t.logo}') center/contain no-repeat;`}
                  aria-hidden="true"
                />
                {t.effort === "dialog-only" ? `Open ${t.name} connector setup` : `Add to ${t.name}`}
              </a>
              {t.note && <p class="mt-2.5 text-xs leading-relaxed text-fg-subtle">{t.note}</p>}
              {/* A deep-link target may ALSO carry steps: the manual fallback
                  when the link is blocked, and - for a link that prefills
                  nothing - the rest of the flow, so the summary says so. */}
              {t.steps && t.steps.length > 0 && (
                <details class="mt-3 group">
                  <summary class="cursor-pointer list-none text-xs text-fg-subtle transition hover:text-accent">
                    <span class="underline decoration-dotted underline-offset-4">
                      {effortMeta[t.effort].stepsLabel}
                    </span>
                  </summary>
                  <ol class="mt-2.5 space-y-2.5">
                    {t.steps.map((step, i) => (
                      <li class="flex gap-3 text-sm text-fg-muted">
                        <span class="grid size-5 shrink-0 place-items-center border border-accent/50 font-mono text-[11px] text-accent">
                          {i + 1}
                        </span>
                        <span class="leading-relaxed">{step}</span>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
            </>
          ) : t.setup_prompt ? (
            <>
              <p class="text-xs leading-relaxed text-fg-subtle">
                {t.effort === "command"
                  ? `Run this in your terminal - it adds the server to ${t.name}.`
                  : `Paste this into ${t.name} - it will add the server for you.`}
              </p>
              <div class="mt-2 flex items-stretch border border-border bg-bg">
                <pre class="max-h-64 flex-1 overflow-y-auto whitespace-pre-wrap break-words px-3 py-2.5 font-mono text-xs leading-relaxed text-fg-muted">{t.setup_prompt}</pre>
                <button
                  type="button"
                  class="copy-btn grid shrink-0 place-items-center border-l border-border px-3 text-fg-muted transition hover:bg-surface-2 hover:text-accent"
                  data-code={t.setup_prompt}
                  aria-label={`Copy the ${t.name} setup prompt`}
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                </button>
              </div>
              {t.note && <p class="mt-2.5 text-xs leading-relaxed text-fg-subtle">{t.note}</p>}
            </>
          ) : (
            <ol class="space-y-2.5">
              {(t.steps ?? []).map((step, i) => (
                <li class="flex gap-3 text-sm text-fg-muted">
                  <span class="grid size-5 shrink-0 place-items-center border border-accent/50 font-mono text-[11px] text-accent">
                    {i + 1}
                  </span>
                  <span class="leading-relaxed">{step}</span>
                </li>
              ))}
            </ol>
          )}
        </div>
      ))
    }
  </div>
</div>

<script>
  import { onClient, setClient } from "../lib/client-state";

  /*
   * Which chat surface to show for a given install target. Only four clients
   * have a shell, so the rest are aliased to the closest one that does - the
   * VS Code forks to VS Code, Claude Code to Claude. Targets with no honest
   * match (Zed, "any MCP client") are absent on purpose: picking one leaves
   * the page's chat surfaces as they were rather than showing a client the
   * visitor didn't choose.
   */
  const CLIENT_FOR_TARGET: Record<string, string> = {
    claude: "claude",
    "claude-code": "claude",
    chatgpt: "chatgpt",
    goose: "goose",
    vscode: "vscode",
    cursor: "vscode",
    cline: "vscode",
    windsurf: "vscode",
  };

  // Clipboard handler for every `.copy-btn` in this widget (the MCP URL and
  // the per-client setup prompt). This used to live in CodeBlock.astro and was
  // inherited only because GetStarted rendered a CodeBlock on the same page;
  // when that section was removed the handler would have vanished with it and
  // both copy buttons would have failed silently. It lives here now, next to
  // the only thing that uses it.
  const CHECK_ICON =
    '<svg class="size-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>';

  function initCopy() {
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      // The widget renders in both the hero and the final CTA, and this runs
      // again on astro:page-load - guard so one click doesn't fire twice.
      if (btn.dataset.copyReady === "true") return;
      btn.dataset.copyReady = "true";
      // Cache the resting icon ONCE. Reading innerHTML at click time breaks on a
      // rapid second click: the checkmark is already showing, so it gets saved
      // as the "original" and the button keeps it forever.
      const restingIcon = btn.innerHTML;
      let revertTimer = 0;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.code ?? "");
          btn.innerHTML = CHECK_ICON;
          // Restart the clock so the second click still shows feedback for the
          // full duration instead of the first timer cutting it short.
          window.clearTimeout(revertTimer);
          revertTimer = window.setTimeout(() => {
            btn.innerHTML = restingIcon;
          }, 1500);
        } catch {
          // Clipboard API unavailable (e.g. non-secure context) - fail quietly.
        }
      });
    });
  }

  /*
   * Copy-then-navigate for deep links that land on an empty form (ChatGPT).
   * The clipboard write has to finish before the page unloads, so this waits
   * on it and then navigates by hand rather than letting the anchor's default
   * race the write. Progressive enhancement: with no JS, or a rejected
   * clipboard, the anchor still navigates and the URL is still on screen.
   */
  function initCopyOnOpen() {
    document.querySelectorAll<HTMLAnchorElement>("a[data-copy-on-open]").forEach((a) => {
      if (a.dataset.copyOpenReady === "true") return;
      a.dataset.copyOpenReady = "true";
      const handle = async (e: MouseEvent) => {
        const url = a.dataset.copyOnOpen ?? "";
        // Modified clicks mean "open elsewhere, keep this page". Hijacking them
        // would swallow that, so copy without preventing the default.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) {
          // Fire-and-forget, so the browser's own navigation is untouched -
          // which also means nothing here may throw into the click handler.
          // Every hop is optional: a missing clipboard object, a missing
          // method, and a non-Promise return each have to be survivable.
          navigator.clipboard?.writeText?.(url)?.catch(() => {});
          return;
        }
        e.preventDefault();
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          // Clipboard API unavailable or denied - fall through and navigate
          // anyway; the panel still shows the URL with its own copy button.
        }
        window.location.href = a.href;
      };

      a.addEventListener("click", handle);
      // Middle-click fires `auxclick` and NOT `click`, so the button !== 0 arm
      // above is unreachable without this line - the new tab would open with
      // nothing on the clipboard. Restricted to button 1: `auxclick` also fires
      // on right-click, and clobbering the clipboard when someone opens a
      // context menu would be a surprise, not an enhancement.
      a.addEventListener("auxclick", (e) => {
        if (e.button === 1) void handle(e);
      });
    });
  }

  function initConnect() {
    document.querySelectorAll<HTMLElement>("[data-connect]").forEach((root) => {
      // Idempotent: skip roots already wired so a repeat call (e.g.
      // astro:page-load after a client navigation) doesn't attach duplicate
      // toggle/document/root listeners.
      if (root.dataset.connectReady === "true") return;
      root.dataset.connectReady = "true";
      const dd = root.querySelector<HTMLElement>("[data-dropdown]");
      const toggle = root.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
      const menu = root.querySelector<HTMLElement>("[data-dropdown-menu]");
      const selLogo = root.querySelector<HTMLElement>("[data-selected-logo]");
      const selName = root.querySelector<HTMLElement>("[data-selected-name]");
      if (!dd || !toggle || !menu || !selLogo || !selName) return;

      const close = () => {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        menu.classList.remove("hidden");
        toggle.setAttribute("aria-expanded", "true");
      };

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        menu.classList.contains("hidden") ? open() : close();
      });

      const options = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-option]"),
      );

      let selectedId = options.find(
        (o) => o.closest("[role=option]")?.getAttribute("aria-selected") === "true",
      )?.dataset.option;

      const select = (opt: HTMLButtonElement) => {
        const id = opt.dataset.option!;
        selectedId = id;
        // Update the trigger label + logo.
        selName.textContent = opt.dataset.name ?? "";
        const mask = `url('${opt.dataset.logo}') center/contain no-repeat`;
        selLogo.style.setProperty("-webkit-mask", mask);
        selLogo.style.setProperty("mask", mask);
        // Swap visible panel + selected state.
        root.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
          p.hidden = p.dataset.panel !== id;
        });
        menu.querySelectorAll<HTMLElement>("[role=option]").forEach((li) => {
          li.setAttribute(
            "aria-selected",
            li.querySelector("[data-option]") === opt ? "true" : "false",
          );
        });
      };

      options.forEach((opt) => {
        opt.addEventListener("click", () => {
          select(opt);
          // Push the choice to the rest of the page (hero shells, features
          // frames) when this target has a chat surface to show.
          const client = CLIENT_FOR_TARGET[opt.dataset.option!];
          if (client) setClient(client);
          close();
        });
      });

      // ...and pull, so picking a client in the hero preselects it here.
      onClient((id) => {
        // Unless what's selected already means this client: picking Cursor
        // sets the page to the VS Code surface, and reacting to that by
        // selecting "VS Code" would throw away the more specific choice the
        // visitor just made - along with Cursor's install instructions.
        if (selectedId && CLIENT_FOR_TARGET[selectedId] === id) return;
        const opt = options.find((o) => o.dataset.option === id);
        if (opt) select(opt);
      });

      // Close on outside click / Escape.
      document.addEventListener("click", (e) => {
        if (!dd.contains(e.target as Node)) close();
      });
      root.addEventListener("keydown", (e) => {
        if ((e as KeyboardEvent).key === "Escape") close();
      });
    });
  }

  function initAll() {
    initConnect();
    initCopy();
    initCopyOnOpen();
  }

  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
