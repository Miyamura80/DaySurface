---
/*
 * The visual for each feature, selected by `name` (the `visual` key on each
 * feature in config). Rendered both in the sticky desktop panel and inline on
 * mobile (Features.astro).
 *
 * These are the REAL MCP App mocks - the same components the hero chat mock
 * embeds (InboxApp / ComposerApp) plus SignerApp - inside a ChatFrame wearing
 * whichever client the page is currently set to. Pick ChatGPT in the hero and
 * these frames are ChatGPT too: same page-level state, same tokens.
 *
 * The app cards themselves deliberately do NOT re-skin with the host. A
 * sandboxed MCP App ships its own UI and renders identically in every client -
 * that's the point of the frame around them changing while they don't.
 */
import ChatFrame from "./chat/ChatFrame.astro";
import InboxApp from "./chat/InboxApp.astro";
import ComposerApp from "./chat/ComposerApp.astro";
import SignerApp from "./chat/SignerApp.astro";

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<div class="feature-visual flex h-full items-center justify-center p-3 sm:p-5">
  {
    /* Drafts you edit, not approve - the composer served into the chat */
    name === "composer" && (
      <ChatFrame say="Drafted a reply to Dana - it's open for you to edit.">
        <ComposerApp standalone />
      </ChatFrame>
    )
  }

  {
    /* Triage that remembers - the curated inbox, list -> reader -> AI reply */
    name === "ledger" && (
      <ChatFrame say="I triaged your inbox. Here's what needs you.">
        <InboxApp />
      </ChatFrame>
    )
  }

  {
    /* Fill and sign, in the thread - the signing ceremony */
    name === "signing" && (
      <ChatFrame say="Filled the form. It needs your signature to go back.">
        <SignerApp />
      </ChatFrame>
    )
  }
</div>

<style>
  /* Pause every attract loop in the panel while the visitor is interacting -
     the same courtesy the hero extends via ConvoScroll, so the composer's real
     textarea and the signer's ceremony hold still under the cursor instead of
     animating out from under it. */
  .feature-visual:hover :global(*),
  .feature-visual:focus-within :global(*) {
    animation-play-state: paused !important;
  }
</style>
