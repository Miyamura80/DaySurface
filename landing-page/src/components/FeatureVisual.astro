---
/*
 * The visual for each feature, selected by `name` (the `visual` key on each
 * feature in config). Rendered both in the sticky desktop panel and inline on
 * mobile (Features.astro).
 *
 * These are diagrams, not product mocks. The hero already stages the real MCP
 * apps in a chat shell; restaging them here just showed the same screenshot
 * twice and left the actual claim ("nothing sends until you do", "only what
 * changed is re-read", "the file never enters the chat") to a paragraph of
 * prose. A diagram says it without the paragraph.
 *
 * Shared language across all three: grey is the agent's half, cyan is yours.
 */
import ComposerDiagram from "./diagrams/ComposerDiagram.astro";
import LedgerDiagram from "./diagrams/LedgerDiagram.astro";
import SigningDiagram from "./diagrams/SigningDiagram.astro";

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<div class="feature-visual flex h-full items-center justify-center p-4 sm:p-6">
  {/* Drafts you edit, not approve */}
  {name === "composer" && <ComposerDiagram />}

  {/* Triage that remembers */}
  {name === "ledger" && <LedgerDiagram />}

  {/* Fill and sign, in the thread */}
  {name === "signing" && <SigningDiagram />}
</div>

<style>
  /* Hold the blinking carets still while the visitor is reading under the
     cursor - the same courtesy the hero extends via ConvoScroll. */
  .feature-visual:hover :global(*),
  .feature-visual:focus-within :global(*) {
    animation-play-state: paused !important;
  }
</style>
