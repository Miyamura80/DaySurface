---
/*
 * Bespoke Edison-brand wireframe diagram for each feature, selected by `name`
 * (the `visual` key on each feature in config). Rendered both in the sticky
 * desktop panel and inline on mobile (Features.astro). Decorative.
 *
 * These draw the *mechanism* behind each feature, not the product UI - the
 * hero chat mock (ChatMock.astro) already stages the composer and the ranked
 * inbox, so restaging either here would just repeat the hero one scroll later.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

{
  /* Drafts you edit, not approve - the draft is real and every field is live */
  name === "composer" && (
    <div class="flex h-full flex-col justify-center p-6" aria-hidden="true">
      <div class="border-2 border-accent bg-bg">
        <div class="flex items-center justify-between border-b border-border px-3 py-2">
          <span class="text-xs font-semibold text-fg">Draft</span>
          <span class="font-mono text-[10px] uppercase tracking-wider text-accent">
            ui://daysurface/gmail_composer
          </span>
        </div>

        {[
          { label: "To", value: "sarah@acme.com" },
          { label: "Subject", value: "Re: Q3 contract" },
        ].map((f) => (
          <div class="flex items-baseline gap-2 border-b border-border px-3 py-1.5">
            <span class="w-12 shrink-0 font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
              {f.label}
            </span>
            <span class="truncate text-[13px] text-fg">{f.value}</span>
          </div>
        ))}

        <div class="border-b border-border px-3 py-2.5">
          <p class="text-[13px] leading-relaxed text-fg">
            Happy to sign off on the revised terms
            <span class="ml-0.5 inline-block h-[13px] w-[2px] translate-y-[2px] bg-accent" />
          </p>
          <p class="mt-2 inline-flex items-center gap-1.5 border border-border px-2 py-1 font-mono text-[10px] text-fg-muted">
            <svg class="size-3 text-fg-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 7v9a4 4 0 008 0V6a2.5 2.5 0 00-5 0v9.5a1 1 0 002 0V7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            terms-v3.pdf
          </p>
        </div>

        <div class="flex items-center justify-between px-3 py-2">
          <span class="font-mono text-[10px] text-fg-subtle">every field editable</span>
          <span class="inline-flex items-center gap-2">
            <span class="font-mono text-[10px] uppercase tracking-wider text-accent">you</span>
            <span class="bg-accent px-2.5 py-1 text-[11px] font-semibold text-accent-fg">Send</span>
          </span>
        </div>
      </div>
    </div>
  )
}

{
  /* Triage that remembers - the ledger turns a full re-read into a delta */
  name === "ledger" && (
    <div class="flex h-full flex-col justify-center p-6" aria-hidden="true">
      <div class="border-2 border-accent bg-bg">
        <div class="inline-flex w-full items-center gap-1.5 border-b border-border px-3 py-2 font-mono text-[11px] text-fg-muted">
          <svg class="size-3 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 8l4 4-4 4m6 0h6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          inbox_get_curation <span class="text-accent">✓</span>
        </div>

        <div class="space-y-3 px-3 py-4">
          {[
            { label: "curated", count: 12, width: "60%", fill: "bg-accent" },
            { label: "stale", count: 3, width: "15%", fill: "bg-accent/40" },
            { label: "uncurated", count: 5, width: "25%", fill: "bg-fg-subtle/40" },
          ].map((row) => (
            <div class="flex items-center gap-2.5">
              <span class="w-16 shrink-0 font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
                {row.label}
              </span>
              <span class="h-2.5 flex-1 border border-border">
                <span class={`block h-full ${row.fill}`} style={`width:${row.width}`} />
              </span>
              <span class="w-4 shrink-0 text-right font-mono text-[11px] text-fg">{row.count}</span>
            </div>
          ))}
        </div>

        <div class="border-t border-border px-3 py-2.5">
          <p class="text-[13px] text-fg">8 threads to re-read, not 20</p>
          <p class="mt-1 font-mono text-[10px] text-fg-subtle">
            verdicts banked at historyId 4471902
          </p>
        </div>
      </div>
    </div>
  )
}

{
  /* Fill and sign - the agent fills, the document locks, only you sign */
  name === "signing" && (
    <div class="flex h-full flex-col justify-center p-6" aria-hidden="true">
      <div class="border-2 border-accent bg-bg">
        <div class="flex items-center justify-between border-b border-border px-3 py-2">
          <span class="text-xs font-semibold text-fg">terms-v3.pdf</span>
          <span class="inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-wider text-accent">
            <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 11V8a5 5 0 0110 0v3" stroke-linecap="round" />
              <rect x="5" y="11" width="14" height="9" rx="1" />
            </svg>
            locked
          </span>
        </div>

        <ul class="divide-y divide-border">
          {[
            { field: "Full name", value: "Alex Rivera" },
            { field: "Effective date", value: "2026-07-28" },
          ].map((r) => (
            <li class="flex items-center gap-2.5 px-3 py-2">
              <span class="size-2 shrink-0 bg-accent" />
              <span class="w-24 shrink-0 font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
                {r.field}
              </span>
              <span class="truncate text-[13px] text-fg">{r.value}</span>
            </li>
          ))}
          <li class="flex items-center gap-2.5 px-3 py-2">
            <span class="size-2 shrink-0 border border-fg-subtle" />
            <span class="w-24 shrink-0 font-mono text-[10px] uppercase tracking-wider text-fg-subtle">
              Signature
            </span>
            <span class="h-[15px] flex-1 border-b border-dashed border-accent" />
          </li>
        </ul>

        <div class="border-t border-border px-3 py-2.5">
          <p class="text-[13px] text-fg">
            Type your full legal name
            <span class="ml-0.5 inline-block h-[13px] w-[2px] translate-y-[2px] bg-accent" />
          </p>
          <p class="mt-1 font-mono text-[10px] text-fg-subtle">
            agent fills the fields - only you sign
          </p>
        </div>
      </div>
    </div>
  )
}
