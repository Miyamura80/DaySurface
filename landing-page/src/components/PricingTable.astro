---
/**
 * Full tier-by-tier feature matrix for /pricing.
 *
 * Both the columns and the cells are keyed off `pricing.tiers`, so the table
 * cannot drift out of sync with the cards above it: a row missing a tier fails
 * to compile. Cell values are `true` (included), `false` (not included), or a
 * string (a limit like "30 days" / "3 / month").
 */
import { pricing, pricingMatrix } from "../config/landing";

const tiers = pricing.tiers;
---

<div class="overflow-x-auto">
  <table class="w-full min-w-[720px] border-collapse text-left">
    <caption class="sr-only">
      DaySurface feature comparison across the {tiers.length} pricing tiers
    </caption>
    <thead>
      <tr class="border-b-2 border-border">
        <th scope="col" class="py-4 pr-4 align-bottom text-sm font-medium text-fg-muted">
          Capability
        </th>
        {
          tiers.map((t) => (
            <th scope="col" class="px-4 py-4 align-bottom text-sm font-semibold text-fg-muted">
              <div>{t.name}</div>
              <div class="mt-1 text-xs font-normal text-fg-subtle">
                {t.price}
                {t.cadence}
              </div>
            </th>
          ))
        }
      </tr>
    </thead>
    {
      pricingMatrix.map((section) => (
        <tbody>
          <tr>
            <th
              scope="rowgroup"
              colspan={tiers.length + 1}
              class="pt-10 pb-3 text-left text-xs font-bold tracking-widest text-accent uppercase"
            >
              {section.group}
            </th>
          </tr>
          {section.rows.map((row) => (
            <tr class="border-b border-border/60 align-top">
              <th scope="row" class="py-4 pr-4 text-left font-normal">
                <div class="font-medium text-fg">{row.capability}</div>
                {row.detail && (
                  <div class="mt-1 max-w-sm text-sm text-fg-muted">{row.detail}</div>
                )}
              </th>
              {tiers.map((t) => {
                const v = row.values[t.id];
                return (
                  <td class="px-4 py-4">
                    {/* aria-label is not exposed on a bare span (role
                        generic), so the state goes in visually-hidden text. */}
                    {v === true && (
                      <>
                        <span class="text-lg font-bold text-accent" aria-hidden="true">
                          ✓
                        </span>
                        <span class="sr-only">Included</span>
                      </>
                    )}
                    {v === false && (
                      <>
                        <span class="text-lg font-bold text-fg-subtle" aria-hidden="true">
                          –
                        </span>
                        <span class="sr-only">Not included</span>
                      </>
                    )}
                    {typeof v === "string" && (
                      <span class="text-sm font-medium text-fg">{v}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</div>
